# ================================================================
# MQnet 통합 플랫폼 - 공통 환경변수 템플릿
# 이 파일을 복사하여 .env.shared로 저장하고 실제 값을 입력하세요.
# ================================================================

# ─── 배포 모드 ───────────────────────────────────────────────
DEPLOYMENT_MODE=LOCAL_STANDALONE
# 옵션: LOCAL_STANDALONE | DOCKER | CLOUD_RENDER | CLOUD_CLOUDRUN

# ─── JWT 인증 (공통) ─────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-here-change-in-production
JWT_EXPIRE_MINUTES=1440

# ─── Supabase (공통 DB) ──────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# PostgreSQL 직접 연결 (Supabase DB URL)
DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# ─── Gemini AI (공통) ────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key
ENABLE_AI=true

# ─── Stripe 결제 (공통) ──────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
ENABLE_PAYMENT=false

# ─── Cloudflare R2 파일 저장소 (공통) ────────────────────────
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=mqnet-uploads
ENABLE_FILE_STORAGE=false

# ─── 알림 (공통) ─────────────────────────────────────────────
KAKAO_API_KEY=your-kakao-api-key
ENABLE_NOTIFICATIONS=false

# ─── 기능 플래그 (공통) ──────────────────────────────────────
ENABLE_CLOUD_SYNC=false
ENABLE_REALTIME=false
