# ================================================================
# MQnet 통합 플랫폼 - Coolify 대시보드 환경변수 (Environment Variables)
# Coolify의 Application > Environment Variables 탭에 복사하여 붙여넣으세요.
# ================================================================

# ─── 배포 모드 및 미디어 경로 ───────────────────────────────
DEPLOYMENT_MODE=DOCKER
MEDIA_PATH=/media
MEDIA_STORAGE_PATH=/media

# ─── JWT 인증 (공통) ─────────────────────────────────────────
JWT_SECRET=mqnet-secret-jwt-token-production-change-this
JWT_EXPIRE_MINUTES=1440

# ─── 데이터베이스 (Supabase 또는 내부 PostgreSQL) ───────────────
DATABASE_URL=sqlite:///./integrat.db
# PostgreSQL을 사용할 경우 예시:
# DATABASE_URL=postgresql://postgres:password@postgres:5432/mqnet

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Gemini AI (공통) ────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here
ENABLE_AI=true

# ─── Stripe 결제 (공통) ──────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ENABLE_PAYMENT=false

# ─── Cloudflare 터널 및 파일 저장소 ──────────────────────────
# Cloudflare Tunnel을 사용할 경우 (미사용 시 Coolify 기본 프록시 도메인 사용 권장)
TUNNEL_TOKEN=
ENABLE_FILE_STORAGE=false

# ─── n8n 워크플로우 설정 (필요시) ────────────────────────────
N8N_HOST=n8n.your-domain.com
N8N_EDITOR_BASE_URL=https://n8n.your-domain.com/
WEBHOOK_URL=https://n8n.your-domain.com/
GENERIC_TIMEZONE=Asia/Seoul
TZ=Asia/Seoul
