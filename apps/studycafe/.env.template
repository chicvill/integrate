# MQnet StudyCafe Unified System Environment Configuration

# 1. Deployment Mode Options: "SAAS_PORTAL" | "LOCAL_STANDALONE"
DEPLOYMENT_MODE=LOCAL_STANDALONE

# 2. Side Modules Options
ENABLE_SELFSTUDY=true
ENABLE_NFC_DOOR=true
ENABLE_CLOUD_SYNC=true

# 3. Database Settings
# For LOCAL_STANDALONE: sqlite:///./studycafe.db
# For SAAS_PORTAL: postgresql://user:password@localhost:5432/studycafe
DATABASE_URL=sqlite:///./studycafe.db

# 4. Security & API Keys
SECRET_KEY=mqnet_studycafe_unified_secret_key_2026
GEMINI_API_KEY=your_gemini_api_key_here

# 5. IoT & MQTT (For N100 Local Door Control)
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_TOPIC_DOOR=studycafe/door/control

# 6. Server Ports
PORT=8001
HOST=0.0.0.0
